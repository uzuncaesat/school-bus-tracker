@page "/"

<PageTitle>Okyanus Servis</PageTitle>

<div class="form-hero" style="border-radius:var(--radius); margin-bottom:18px; box-shadow:var(--shadow);">
    <h2>🚌 Okyanus Servis</h2>
    <p>Veli kaydı, araç yönetimi, şoför bindi/indi ve veli portalı — tek panelde.</p>
</div>

<div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:14px;">
    <a class="tcard" href="kayit-ekle" style="margin-bottom:0; text-decoration:none; color:var(--ink); display:block;">
        <h3>➕ Yeni Kayıt</h3>
        <p class="csub" style="margin:0">Haritadan konumla yeni veli kaydı ekle.</p>
    </a>
    <a class="tcard" href="kayitlar" style="margin-bottom:0; text-decoration:none; color:var(--ink); display:block;">
        <h3>📋 Panel</h3>
        <p class="csub" style="margin:0">Tüm kayıtları gör, ara, düzenle.</p>
    </a>
    <a class="tcard" href="araclar" style="margin-bottom:0; text-decoration:none; color:var(--ink); display:block;">
        <h3>🚐 Araçlar</h3>
        <p class="csub" style="margin:0">Araç doluluğunu ve öğrencileri izle.</p>
    </a>
    <a class="tcard" href="duyurular" style="margin-bottom:0; text-decoration:none; color:var(--ink); display:block;">
        <h3>📢 Duyurular</h3>
        <p class="csub" style="margin:0">Tüm velilere toplu duyuru gönder.</p>
    </a>
</div>
