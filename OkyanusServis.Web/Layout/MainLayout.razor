@inherits LayoutComponentBase
@inject OkyanusServis.Web.Services.AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="topbar">
    <div class="topbar-inner">
        <a class="brand" href="">
            <span class="logo">
                <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17V6a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v11"/><path d="M17 8h2.5a2 2 0 0 1 1.8 1.1L22 11v6"/><path d="M2 17h20"/><circle cx="7" cy="18" r="1.6" fill="#fff"/><circle cx="17" cy="18" r="1.6" fill="#fff"/><path d="M4 9h13"/></svg>
            </span>
            <span>
                <h1>Okyanus Servis</h1>
                <span>Dijital Yönetim Sistemi</span>
            </span>
        </a>

        <div class="user-box">
            <button class="theme-btn" @onclick="TemaDegistir" title="Tema değiştir">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            </button>
            <AuthorizeView>
                <Authorized>
                    <span class="um">@context.User.Identity?.Name</span>
                    <button class="tbtn ghost" style="padding:8px 12px" @onclick="Cikis">Çıkış</button>
                </Authorized>
                <NotAuthorized>
                    <a class="tbtn" style="padding:8px 14px" href="giris">Giriş</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</div>

<div class="tabbar">
    <div class="tabbar-inner">
        <AuthorizeView Roles="Admin,Driver">
            <Authorized>
                <NavLink class="tab" href="ozet">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18M7 15l4-4 3 3 5-6"/></svg> Özet
                </NavLink>
                <NavLink class="tab" href="kayit-ekle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg> Yeni Kayıt
                </NavLink>
                <NavLink class="tab" href="kayitlar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="4" rx="1"/><rect x="3" y="10" width="18" height="4" rx="1"/><rect x="3" y="16" width="18" height="4" rx="1"/></svg> Panel
                </NavLink>
                <NavLink class="tab" href="araclar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17V6a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v11"/><path d="M2 17h20"/><circle cx="7" cy="18" r="1.4"/><circle cx="16" cy="18" r="1.4"/></svg> Araçlar
                </NavLink>
                <NavLink class="tab" href="duyurular">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0"/></svg> Duyurular
                </NavLink>
                <NavLink class="tab" href="tahsilat">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg> Tahsilat
                </NavLink>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Admin" Context="adminCtx">
            <Authorized>
                <NavLink class="tab" href="veli-hesaplari">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-3.3 3.6-6 8-6s8 2.7 8 6"/></svg> Veli Hesapları
                </NavLink>
                <NavLink class="tab" href="personel">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg> Personel
                </NavLink>
                <NavLink class="tab" href="takip-ayarlari">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/><path d="M19.4 15a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-2.7 1.1V21a2 2 0 1 1-4 0v-.1a1.6 1.6 0 0 0-2.7-1.1l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.6 1.6 0 0 0-1.1-2.7H3a2 2 0 1 1 0-4h.1a1.6 1.6 0 0 0 1.1-2.7l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.6 1.6 0 0 0 1.8.3H9a1.6 1.6 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.6 1.6 0 0 0 2.7 1.1l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0-.3 1.8V9a1.6 1.6 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.6 1.6 0 0 0-1.5 1z"/></svg> Takip Ayarları
                </NavLink>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Veli" Context="veliCtx">
            <Authorized>
                <NavLink class="tab" href="portalim">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17V6a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v11"/><path d="M2 17h20"/><circle cx="7" cy="18" r="1.4"/><circle cx="16" cy="18" r="1.4"/></svg> Servisim
                </NavLink>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

<div class="wrap">
    @Body
</div>

@code {
    private async Task TemaDegistir() => await JS.InvokeVoidAsync("okTheme.toggle");

    private async Task Cikis()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("giris");
    }
}
